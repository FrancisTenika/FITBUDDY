      ],
      "source": [
        "documents = [\n",
        "    {\n",
        "        \"source\": \"Sample PDF, page 3\",\n",
        "        \"text\": \"Users can reset their password using \"\n",
        "                \"the Forgot Password option on the login page.\"\n",
        "    },\n",
        "    {\n",
        "        \"source\": \"Sample PDF, page 4\",\n",
        "        \"text\": \"Users should contact the support team \"\n",
        "                \"to verify a duplicate charge.\"\n",
        "    },\n",
        "    {\n",
        "        \"source\": \"Sample PDF, page 5\",\n",
        "        \"text\": \"Customers can check their order status \"\n",
        "                \"through the order tracking page.\"\n",
        "    }\n",
        "]\n",
        "\n",
        "print(\"Knowledge base created successfully!\")\n",
        "print(\"Total documents:\", len(documents))\n",
        "\n",
        "def retrieve_context(query):\n",
        "    query_words = set(query.lower().split())\n",
        "\n",
        "    results = []\n",
        "\n",
        "    for doc in documents:\n",
        "        text = doc[\"text\"].lower()\n",
        "        score = sum(\n",
        "            1 for word in query_words\n",
        "            if word in text\n",
        "        )\n",
        "\n",
        "        if score > 0:\n",
        "            results.append((score, doc))\n",
        "\n",
        "    results.sort(key=lambda x: x[0], reverse=True)\n",
        "\n",
        "    return [doc for score, doc in results[:2]]\n",
        "\n",
        "\n",
        "query = \"How can I reset my password?\"\n",
        "context = retrieve_context(query)\n",
        "\n",
        "for doc in context:\n",
        "    print(\"Retrieved:\", doc[\"text\"])\n",
        "    print(\"Source:\", doc[\"source\"])\n",
        "\n",
        "\n",
        "def answer_query(user_query):\n",
        "    context = retrieve_context(user_query)\n",
        "\n",
        "    if not context:\n",
        "        return \"Information not found in the documents.\"\n",
        "\n",
        "    text = \" \".join(doc[\"text\"] for doc in context)\n",
        "    sources = \", \".join(doc[\"source\"] for doc in context)\n",
        "\n",
        "    if \"password\" in user_query.lower():\n",
        "        answer = (\n",
        "            \"Open the login page, select \"\n",
        "            \"'Forgot Password,' and follow the instructions \"\n",
        "            \"to create a new password.\"\n",
        "        )\n",
        "    elif \"charge\" in user_query.lower():\n",
        "        answer = (\n",
        "            \"Contact the support team to verify \"\n",
        "            \"the duplicate charge.\"\n",
        "        )\n",
        "    else:\n",
        "        answer = text\n",
        "\n",
        "    return f\"Answer: {answer}\\nSource: {sources}\"\n",
        "\n",
        "\n",
        "print(answer_query(\"How can I reset my password?\"))\n"
      ]
    }
